#!/bin/bash
# Git Hook - Prepare-commit-msg
# 此 hook 委派給 scripts/ollama_commit.sh 執行 commit 訊息增強
# 消除代碼重複，統一邏輯維護於 scripts 資料夾

# Source the shared library
# 引導引導代碼：找到 lib.sh 的實際路徑，以便加載共享函數
# 此區塊必須最小化且獨立，以避免加載前的依賴循環
HOOK_DIR="$(cd "$(dirname -- "$0")" && pwd)"
HOOK_REAL="$0"
depth=0
# 遞迴解析符號連結，限制深度為 10 層以防止無限迴圈
while [ -L "$HOOK_REAL" ] && [ "$depth" -lt 10 ]; do
  depth=$((depth + 1))
  HOOK_DIR="$(cd "$(dirname -- "$HOOK_REAL")" && pwd)"
  HOOK_REAL="$(readlink -- "$HOOK_REAL")"
  [ "${HOOK_REAL#/}" = "$HOOK_REAL" ] && HOOK_REAL="$HOOK_DIR/$HOOK_REAL"
done

if [ -L "$HOOK_REAL" ]; then
  echo "Error: Maximum symlink depth reached for $0" >&2
  exit 1
fi

HOOK_DIR="$(cd "$(dirname -- "$HOOK_REAL")" && pwd)"
# shellcheck source=./lib.sh
source "$HOOK_DIR/lib.sh"

# Determine repository root
if ! get_repo_root "$HOOK_DIR"; then
  exit 1
fi

# Get parameters from git hook
COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Call the commit script with parameters
"$REPO_ROOT/scripts/ollama_commit.sh" --commit-file "$COMMIT_MSG_FILE" --commit-source "$COMMIT_SOURCE"
