#!/bin/bash
# Git Hook - Prepare-commit-msg
# 此 hook 委派給 scripts/ollama_commit.sh 執行 commit 訊息增強
# 消除代碼重複，統一邏輯維護於 scripts 資料夾

# 策略：優先使用 git rev-parse，回退到符號鏈接解析
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

if [[ -z "$REPO_ROOT" ]]; then
  # 回退方案：從符號鏈接的源頭 hook 檔案位置推導
  # 此 hook 檔案實際路徑是 ollama-git-tools/hooks/prepare-commit-msg
  # 需要上兩級目錄找到 ollama-git-tools 根目錄
  HOOK_FILE_REAL="$(readlink -f "$0")"
  REPO_ROOT="$(dirname "$(dirname "$HOOK_FILE_REAL")")"
fi

if [[ -z "$REPO_ROOT" ]] || [[ ! -d "$REPO_ROOT/scripts" ]]; then
  echo "❌ Error: Cannot find ollama-git-tools repository root"
  echo "   REPO_ROOT=$REPO_ROOT"
  exit 1
fi

# 從 git hook 獲取參數
COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# 調用 scripts 中的 commit 腳本，並傳遞參數
"$REPO_ROOT/scripts/ollama_commit.sh" --commit-file "$COMMIT_MSG_FILE" --commit-source "$COMMIT_SOURCE"
